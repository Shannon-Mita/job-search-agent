# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.

# Email digest (Gmail SMTP)
GMAIL_ADDRESS=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_app_password_here
NOTIFY_EMAIL=your_gmail@gmail.com

# Reed API (free — get key at reed.co.uk/developers)
REED_API_KEY=your_reed_api_key_here

# Optional: SerpAPI for Google Jobs (£40/mo — confirm before adding)
# SERPAPI_KEY=

# LoopCV B2B API (structured jobs — get key at api-docs.loopcv.com after signup)
LOOPCV_API_KEY=your_loopcv_api_key_here

# Jooble API (structured jobs — free tier, get key at jooble.org/api/about)
JOOBLE_API_KEY=your_jooble_api_key_here

# Adzuna API (structured jobs — free tier, 1,000 calls/month, get keys at developer.adzuna.com)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Anthropic API (feedback_learning.py — get key at console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Agent behaviour
LOG_LEVEL=INFO
